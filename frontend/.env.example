# Copie este arquivo para ".env" (mesma pasta) e preencha.

# Endereço do backend, sempre com http:// ou https:// e sem barra no final.
#  - Testando no seu PC (Expo Go):  http://SEU-IP-LOCAL:5000   (veja o IP com: ipconfig)
#  - Backend publicado:             https://SEU-SERVICO.onrender.com
EXPO_PUBLIC_API_URL=http://192.168.0.10:5000

# OPCIONAL (deixe vazio para desligar o Sentry)
EXPO_PUBLIC_SENTRY_DSN=
